# PolicyPal AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Anthropic API (required for baseline + summary generation) ──
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Model settings ──────────────────────────────────────────────
# Set to "true" to serve from local fine-tuned model instead of Claude API
USE_FINETUNED=false

# Fine-tuned model path (used when USE_FINETUNED=true)
FINETUNED_MODEL_PATH=models/policypal-qlora/final

# Base model for fine-tuning (HuggingFace ID or local path)
BASE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# ── HuggingFace (optional — for gated models like LLaMA-3) ──────
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ── Vector Store ────────────────────────────────────────────────
VSTORE_DIR=data/vectorstore
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Server ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
